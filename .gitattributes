# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set encoding for web files
*.html text eol=crlf encoding=utf-8
*.css text eol=crlf encoding=utf-8
*.js text eol=crlf encoding=utf-8
*.json text eol=crlf encoding=utf-8
*.md text eol=crlf encoding=utf-8
*.txt text eol=crlf encoding=utf-8

# These files are text and should be normalized (Convert crlf => lf)
*.sql text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.rar binary

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf encoding=utf-8

# Config files
.env text eol=lf
.env.* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
